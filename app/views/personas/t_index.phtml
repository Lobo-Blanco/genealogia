<script>
    /**
     * Filtrar por sexo
     */
    function filtrarSexo(sexo) {
        const filas = document.querySelectorAll('.table-genealogia tbody tr');
        const botones = document.querySelectorAll('.toolbar-left .btn-genealogia-outline-secondary');
        
        // Actualizar botones activos
        botones.forEach(btn => {
            btn.classList.remove('active');
            btn.style.background = 'transparent';
            btn.style.color = '#6c757d';
        });
        
        // Marcar botón activo
        const evento = event || window.event;
        if (evento && evento.target) {
            const btn = evento.target.closest('button');
            if (btn) {
                btn.classList.add('active');
                btn.style.background = '#4a6741';
                btn.style.color = 'white';
            }
        }
        
        // Filtrar filas
        filas.forEach(fila => {
            const sexoCell = fila.querySelector('td:nth-child(4)');
            if (!sexoCell) return;
            
            const texto = sexoCell.textContent.trim();
            
            if (sexo === 'todos' || texto.includes(sexo)) {
                fila.style.display = '';
            } else {
                fila.style.display = 'none';
            }
        });
    }
    
    /**
     * Mostrar todos los registros
     */
    function filtrarTodos() {
        const filas = document.querySelectorAll('.table-genealogia tbody tr');
        const botones = document.querySelectorAll('.toolbar-left .btn-genealogia-outline-secondary');
        
        botones.forEach(btn => {
            btn.classList.remove('active');
            btn.style.background = 'transparent';
            btn.style.color = '#6c757d';
        });
        
        filas.forEach(fila => {
            fila.style.display = '';
        });
    }
    
    /**
     * Búsqueda en tiempo real
     */
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.querySelector('.search-form input[name="q"]');
        if (searchInput) {
            searchInput.addEventListener('keyup', function(e) {
                const busqueda = this.value.toLowerCase().trim();
                const filas = document.querySelectorAll('.table-genealogia tbody tr');
                
                filas.forEach(fila => {
                    const texto = fila.textContent.toLowerCase();
                    if (busqueda === '' || texto.includes(busqueda)) {
                        fila.style.display = '';
                    } else {
                        fila.style.display = 'none';
                    }
                });
            });
        }
    });
</script>