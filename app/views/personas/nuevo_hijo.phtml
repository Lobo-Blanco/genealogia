<script>
    function actualizarFechaFiliacion() {
        const tipo_filiacion = document.querySelector('[name="tipo_filiacion"]');
        const campo = document.getElementById('fecha-inicio-filiacion');

        if (!tipo_filiacion || !campo) {
            return;
        }

        campo.style.display =
            tipo_filiacion.value === 'biologica'
                ? 'none'
                : '';
    }

    document.addEventListener('DOMContentLoaded', function () {
        const tipo_filiacion = document.querySelector('[name="tipo_filiacion"]');

        if (tipo_filiacion) {
            tipo_filiacion.addEventListener(
                'change',
                actualizarFechaFiliacion
            );
        }

        actualizarFechaFiliacion();
    });
</script>