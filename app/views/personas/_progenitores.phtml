<script type="text/javascript">
var progenitorRolActual = null;

function abrirProgenitor(rol) {
    progenitorRolActual = rol;
    document.getElementById('progenitor_modal_titulo').innerHTML = rol == 'padre' ? 'Establecer padre' : 'Establecer madre';
    document.getElementById('progenitor_busqueda').value = '';
    document.getElementById('progenitor_nuevo_nombre').value = '';
    document.getElementById('progenitor_nuevo_apellidos').value = '';
    document.getElementById('progenitor_nuevo_fecha_nacimiento').value = '';
    document.getElementById('progenitor_nuevo_lugar_nacimiento').value = '';
    document.getElementById('progenitor_nuevo_notas').value = '';
    filtrarProgenitores();
    document.getElementById('progenitor_modal').style.display = 'block';
}

function cerrarProgenitor() {
    document.getElementById('progenitor_modal').style.display = 'none';
    progenitorRolActual = null;
}

function filtrarProgenitores() {
    var texto = document.getElementById('progenitor_busqueda').value.toLowerCase();
    var botones = document.getElementsByClassName('progenitor_candidato');
    var sexo = progenitorRolActual == 'padre' ? 'H' : 'M';

    for (var i = 0; i < botones.length; i++) {
        var nombre = botones[i].getAttribute('data-nombre').toLowerCase();
        var coincide = botones[i].getAttribute('data-sexo') == sexo && nombre.indexOf(texto) != -1;
        botones[i].style.display = coincide ? 'block' : 'none';
    }
}

function seleccionarProgenitorExistente(boton) {
    var rol = progenitorRolActual;
    document.getElementById(rol + '_modo').value = 'existente';
    document.getElementById(rol + '_existente').value = boton.getAttribute('data-id');
    document.getElementById(rol + '_nombre').value = '';
    document.getElementById(rol + '_apellidos').value = '';
    document.getElementById(rol + '_fecha_nacimiento').value = '';
    document.getElementById(rol + '_lugar_nacimiento').value = '';
    document.getElementById(rol + '_notas').value = '';
    document.getElementById(rol + '_resumen').innerHTML = boton.getAttribute('data-nombre');
    cerrarProgenitor();
}

function crearProgenitorNuevo() {
    var rol = progenitorRolActual;
    var nombre = document.getElementById('progenitor_nuevo_nombre').value;
    var apellidos = document.getElementById('progenitor_nuevo_apellidos').value;

    if (!nombre || !apellidos) {
        alert('Nombre y apellidos son obligatorios.');
        return;
    }

    document.getElementById(rol + '_modo').value = 'nuevo';
    document.getElementById(rol + '_existente').value = '';
    document.getElementById(rol + '_nombre').value = nombre;
    document.getElementById(rol + '_apellidos').value = apellidos;
    document.getElementById(rol + '_fecha_nacimiento').value = document.getElementById('progenitor_nuevo_fecha_nacimiento').value;
    document.getElementById(rol + '_lugar_nacimiento').value = document.getElementById('progenitor_nuevo_lugar_nacimiento').value;
    document.getElementById(rol + '_notas').value = document.getElementById('progenitor_nuevo_notas').value;
    document.getElementById(rol + '_resumen').innerHTML = nombre + ' ' + apellidos + ' (persona nueva)';
    cerrarProgenitor();
}
</script>
