<?php
$arbol = Auth::arbolActual();
$listaProgenitores = array();
$padreActual = null;
$madreActual = null;

if ($arbol) {
    $modeloPersonas = new Personas();
    $listaProgenitores = $modeloPersonas->find(
        'conditions: arbol_id = ' . intval($arbol->id) .
        ' AND id != ' . intval($persona->id),
        'order: apellidos, nombre'
    );

    if (!empty($persona->id)) {
        $filiaciones = new Filiaciones();
        $relaciones = $filiaciones->find(
            'conditions: hijo_id = ' . intval($persona->id)
        );

        foreach ($relaciones as $relacion) {
            $progenitor = $modeloPersonas->find_first(
                'conditions: arbol_id = ' . intval($arbol->arbol_id) .
                ' AND id = ' . intval($relacion->progenitor_id)
            );

            if (!$progenitor) {
                continue;
            }

            if ($progenitor->sexo == 'H' && !$padreActual) {
                $padreActual = $progenitor;
            } elseif ($progenitor->sexo == 'M' && !$madreActual) {
                $madreActual = $progenitor;
            }
        }
    }
}
?>

