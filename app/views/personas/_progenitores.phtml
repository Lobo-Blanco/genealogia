<div id="progenitor_modal" style="display:none; border:1px solid #888; padding:1em; margin:1em 0; background:#fff;">
    <h3 id="progenitor_modal_titulo">Establecer progenitor</h3>

    <p>
        <label for="progenitor_busqueda">Buscar persona existente</label><br>
        <input type="text" id="progenitor_busqueda" onkeyup="filtrarProgenitores()" autocomplete="off">
    </p>

    <div id="progenitor_resultados" style="max-height:15em; overflow:auto;">
        <?php foreach ($listaProgenitores as $candidato): ?>
