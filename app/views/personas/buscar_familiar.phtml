<h2>
    Añadir
    <?= $tipo == 'progenitor' ? 'progenitor' : 'hijo' ?>
    de
    <?= $persona->nombre ?>
    <?= $persona->apellidos ?>
</h2>

<?= Form::open() ?>

<p>
    <?= Form::text(
        'buscar',
        '',
        ''
    ) ?>

    <?= Form::submit(
        'buscar',
        'Buscar'
    ) ?>
</p>

<?= Form::close() ?>

<?php if ($resultados): ?>

    <h3>Personas encontradas</h3>

    <table>
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Apellidos</th>
                <th>Fecha nacimiento</th>
                <th>Acción</th>
            </tr>
        </thead>

        <tbody>

        <?php foreach ($resultados as $resultado): ?>

            <tr>

                <td>
                    <?= $resultado->nombre ?>
                </td>

                <td>
                    <?= $resultado->apellidos ?>
                </td>

                <td>
                    <?= $resultado->fecha_nacimiento ?>
                </td>

                <td>

                    <?= Form::open(
                        'personas/guardar_familiar/' .
                        $persona->id . '/' .
                        $tipo
                    ) ?>

                    <?= Form::hidden(
                        'persona_existente', '',
                        $resultado->id
                    ) ?>

                    <?= Form::hidden(
                        'tipo_filiacion', '',
                        'biologica'
                    ) ?>

                    <?= Form::submit(
                        'seleccionar',
                        $tipo == 'progenitor'
                            ? 'Añadir como progenitor'
                            : 'Añadir como hijo'
                    ) ?>

                    <?= Form::close() ?>

                </td>

            </tr>

        <?php endforeach; ?>

        </tbody>
    </table>

<?php elseif (
    Input::hasPost('buscar')
): ?>

    <p>
        No se han encontrado personas.
    </p>

<?php endif; ?>

<p>
    <?= Html::link(
        'personas/nuevo_familiar/' .
        $persona->id . '/' . $tipo,
        'Crear nueva persona'
    ) ?>
</p>

<p>
    <?= Html::link(
        'personas/familia/' . $persona->id,
        'Volver a familia'
    ) ?>
</p>