                <th>Hasta</th>
            </tr>
        </thead>

        <tbody>

        <?php foreach ($hijos as $filiacion): ?>

            <?php
            $hijo =
                $persona->find(
                    $filiacion->hijo_id
                );
            ?>

            <tr>

                <td>
                    <?= Html::link(
                        'personas/ver/' .
                        $hijo->id,
                        $hijo->nombre .
                        ' ' .
