                    <?= ucfirst(
                        $filiacion->tipo
                    ) ?>
                </td>

                <td>
                    <?= $filiacion->fecha_inicio ?>
                </td>

                <td>
                    <?= $filiacion->fecha_fin ?>
                </td>-->

                <td>
                    <?php if (Auth::puedeEditarFiliacion($filiacion->id)): ?>
                        <?= Html::link(
                            'personas/editar_filiacion/' .
                            $filiacion->id . '/' . $estaPersonaId,
                            'Editar'
                        ) ?>

                        <?= Html::link(
