                    ) ?>
                </td>

                <td>
                    <?= ucfirst(
                        $filiacion->tipo
                    ) ?>
                </td>

                <td>
                    <?= $filiacion->fecha_inicio ?>
                </td>

                <td>
                    <?= $filiacion->fecha_fin ?>
