// Función para formatear fecha a dd/mm/aaaa
function formatearFecha($fecha) {
    if (empty($fecha) || $fecha == '0000-00-00' || $fecha == '') {
        return '';
    }
    
    $timestamp = strtotime($fecha);
    if ($timestamp === false) {
        return $fecha;
    }
    
    // Usar IntlDateFormatter (requiere extensión intl)
    $formatter = new IntlDateFormatter(
        'es_ES',
        IntlDateFormatter::NONE,
        IntlDateFormatter::NONE,
        null,
        null,
        "d 'de' MMMM 'de' yyyy"
    );
    
    return $formatter->format($timestamp);
}

// Función para obtener el badge de sexo
function badgeSexo($sexo) {
    $icono = '';
    $clase = '';
    $label = '';
    
    if ($sexo == 'H') {
        $icono = 'bi-gender-male';
        $clase = 'H';
        $label = 'Masculino';
    } elseif ($sexo == 'M') {
        $icono = 'bi-gender-female';
        $clase = 'M';
        $label = 'Femenino';
    } else {
        $icono = 'bi-gender-ambiguous';
        $clase = 'O';
        $label = 'Otro';
    }
    
    return '<span class="badge-sexo ' . $clase . '"><i class="bi ' . $icono . '"></i> ' . $label . '</span>';
}

