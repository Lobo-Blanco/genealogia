<?= Tag::js("js_family_tree.umd") ?>

<script>
(function () {
    var data = <?= $datosArbolJson ?>;
    var container = document.getElementById('genealogia-family-tree');

    if (!container || typeof FT === 'undefined') {
        return;
    }

    if (typeof FT !== 'undefined') {
        var tree = new FT.FamilyTree(data, container, {
            nodeClickFunction: function (node, ft) {
                ft.nodeClickHandler(node);

                if (node.isPerson) {
                    mostrarFicha(node.data.id);
                }
            },

            nodeTooltipFunction: function (node) {
                return crearTooltip(node);
            }
        });
    }

    function mostrarFicha(personaId) {
        var persona = data.persons[personaId];

        if (!persona) {
            return;
        }

        var progenitores = obtenerProgenitores(personaId);
        var parejas = obtenerParejas(personaId);
        var hijos = obtenerHijos(personaId);

        var html = '<h2>' +
            escapeHtml(persona.name) +
            '</h2>';

        if (persona.birthyear) {
            html += '<p><strong>Nacimiento:</strong> ' +
                persona.birthyear;

            if (persona.birthplace) {
                html += ' — ' +
                    escapeHtml(persona.birthplace);
            }

            html += '</p>';
        }

        if (persona.deathyear) {
            html += '<p><strong>Defunción:</strong> ' +
                persona.deathyear;

            if (persona.deathplace) {
                html += ' — ' +
                    escapeHtml(persona.deathplace);
            }

            html += '</p>';
        }

        if (progenitores.length) {
            html += '<h3>Progenitores</h3><ul>';

            progenitores.forEach(function (progenitor) {
                html += '<li>' +
                    escapeHtml(progenitor.name) +
                    '</li>';
            });

            html += '</ul>';
        }

        if (parejas.length) {
            html += '<h3>Parejas</h3><ul>';

            parejas.forEach(function (pareja) {
                html += '<li>' +
                    escapeHtml(pareja.name) +
                    '</li>';
            });

            html += '</ul>';
        }

        if (hijos.length) {
            html += '<h3>Hijos</h3><ul>';

            hijos.forEach(function (hijo) {
                html += '<li>' +
                    escapeHtml(hijo.name) +
                    '</li>';
            });

            html += '</ul>';
        }

        document.getElementById(
            'genealogia-persona-info'
        ).innerHTML = html;
    }

    function crearTooltip(node) {
        var personaId = node.data.id;
        var persona = data.persons[personaId];

        if (!persona) {
            return '';
        }

        return '<strong>' + escapeHtml(persona.name) + '</strong>';
    }

    function escapeHtml(texto) {
        if (texto === null || texto === undefined) {
            return '';
        }

        texto = String(texto);

        var mapa = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };

        return texto.replace(/[&<>"']/g, function (caracter) {
            return mapa[caracter];
        });
    }

    function obtenerProgenitores(personaId) {
        var progenitores = [];

        Object.keys(data.unions).forEach(function (unionId) {
            var union = data.unions[unionId];

            if (!Array.isArray(union.children)) {
                return;
            }

            if (union.children.indexOf(personaId) === -1) {
                return;
            }

            union.partner.forEach(function (id) {
                if (data.persons[id]) {
                    progenitores.push(data.persons[id]);
                }
            });
        });

        return progenitores;
    }
    
    function obtenerHijos(personaId) {
        var hijos = [];

        obtenerUniones(personaId).forEach(function (union) {
            union.children.forEach(function (id) {
                if (data.persons[id]) {
                    hijos.push(data.persons[id]);
                }
            });
        });

        return hijos;
    }

    function obtenerParejas(personaId) {
        var parejas = [];

        obtenerUniones(personaId).forEach(function (union) {
            union.partner.forEach(function (id) {
                if (id !== personaId && data.persons[id]) {
                    parejas.push(data.persons[id]);
                }
            });
        });

        return parejas;
    }

    function obtenerUniones(personaId) {
        var uniones = [];

        Object.keys(data.unions).forEach(function (unionId) {
            var union = data.unions[unionId];

            if (union.partner.indexOf(personaId) !== -1) {
                uniones.push(union);
            }
        });

        return uniones;
    }
})();
</script>
