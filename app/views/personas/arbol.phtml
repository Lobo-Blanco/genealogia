<script>
(function () {
    var data = <?= $datosArbolJson ?>;

    var container =
        document.getElementById('genealogia-family-tree');

    var info =
        document.getElementById('genealogia-persona-info');

    if (!container || typeof FT === 'undefined') {
        return;
    }

    /*
     * ---------------------------------------------------------
     *  UTILIDADES
     * ---------------------------------------------------------
     */
    function escapeHtml(texto) {
        if (texto === null || texto === undefined) {
            return '';
        }

        texto = String(texto);

        var mapa = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#039;'
        };

        return texto.replace(/[&<>"']/g, function (caracter) {
            return mapa[caracter];
        });
    }

    /*
     * ---------------------------------------------------------
     *  PROGENITORES
     * ---------------------------------------------------------
     */
    function obtenerProgenitores(personaId) {
        var progenitores = [];

        Object.keys(data.unions).forEach(function (unionId) {

            var union = data.unions[unionId];

            if (!Array.isArray(union.children)) {
                return;
            }

            if (union.children.indexOf(personaId) === -1) {
                return;
            }

            if (!Array.isArray(union.partner)) {
                return;
            }

            union.partner.forEach(function (id) {
                if (data.persons[id]) {
                    progenitores.push(data.persons[id]);
                }
            });
        });

        return progenitores;
    }

    /*
     * ---------------------------------------------------------
     *  PAREJAS
     * ---------------------------------------------------------
     */
    function obtenerParejas(personaId) {
        var parejas = [];

        Object.keys(data.unions).forEach(function (unionId) {

            var union = data.unions[unionId];

            if (!Array.isArray(union.partner)) {
                return;
            }

            if (union.partner.indexOf(personaId) === -1) {
                return;
            }

            union.partner.forEach(function (id) {

                if (
                    id !== personaId &&
                    data.persons[id]
                ) {
                    parejas.push(data.persons[id]);
                }
            });
        });

        return parejas;
    }


    /*
     * ---------------------------------------------------------
     *  HIJOS
     * ---------------------------------------------------------
     */
    function obtenerHijos(personaId) {
        var hijos = [];

        Object.keys(data.unions).forEach(function (unionId) {

            var union = data.unions[unionId];

            if (!Array.isArray(union.partner)) {
                return;
            }

            if (union.partner.indexOf(personaId) === -1) {
                return;
            }

            if (!Array.isArray(union.children)) {
                return;
            }

            union.children.forEach(function (id) {

                if (data.persons[id]) {
                    hijos.push(data.persons[id]);
                }
            });
        });

        return hijos;
    }

    /*
     * ---------------------------------------------------------
     *  ENLACE A OTRA PERSONA
     * ---------------------------------------------------------
     *
     * No usamos un <a href="..."> para navegar entre familiares.
     * Utilizamos un botón/enlace interno que será atendido por
     * el manejador del div de información.
     */
    function enlacePersona(persona) {
        if (!persona || !persona.id) {
            return '';
        }

        return '<a href="#" ' +
            'class="genealogia-persona-link" ' +
            'data-persona-id="' +
            escapeHtml(persona.id) +
            '">' +
            escapeHtml(persona.name) +
            '</a>';
    }

    /*
     * ---------------------------------------------------------
     *  FICHA DE UNA PERSONA
     * ---------------------------------------------------------
     *
     * IMPORTANTE:
     * Esta función recibe SIEMPRE el ID de la persona.
     */
    function mostrarFicha(personaId) {
        var persona = data.persons[personaId];

        if (!persona) {
            return;
        }

        var progenitores =
            obtenerProgenitores(personaId);

        var parejas =
            obtenerParejas(personaId);

        var hijos =
            obtenerHijos(personaId);

        var html =
            '<h2>' +
            escapeHtml(persona.name) +
            '</h2>';

        /*
         * Nacimiento
         */
        if (persona.birthyear) {
            html +=
                '<p>' +
                '<strong>Nacimiento:</strong> ' +
                escapeHtml(persona.birthyear);

            if (persona.birthplace) {
                html +=
                    ' — ' +
                    escapeHtml(persona.birthplace);
            }

            html += '</p>';
        }

        /*
         * Defunción
         */
        if (persona.deathyear) {
            html +=
                '<p>' +
                '<strong>Defunción:</strong> ' +
                escapeHtml(persona.deathyear);

            if (persona.deathplace) {
                html +=
                    ' — ' +
                    escapeHtml(persona.deathplace);
            }

            html += '</p>';
        }

        /*
         * Progenitores
         */
        if (progenitores.length) {
            html +=
                '<h3>Progenitores</h3>' +
                '<ul>';

            progenitores.forEach(function (progenitor) {
                html +=
                    '<li>' +
                    enlacePersona(progenitor) +
                    '</li>';
            });

            html += '</ul>';
        }

        /*
         * Parejas
         */
        if (parejas.length) {
            html +=
                '<h3>Parejas</h3>' +
                '<ul>';

            parejas.forEach(function (pareja) {
                html +=
                    '<li>' +
                    enlacePersona(pareja) +
                    '</li>';
            });

            html += '</ul>';
        }

        /*
         * Hijos
         */
        if (hijos.length) {

            html +=
                '<h3>Hijos</h3>' +
                '<ul>';

            hijos.forEach(function (hijo) {
                html +=
                    '<li>' +
                    enlacePersona(hijo) +
                    '</li>';
            });

            html += '</ul>';
        }

        /*
         * Ficha completa
         */
        html +=
            '<p class="genealogia-ficha-completa">' +
            '<button type="button" ' +
            'class="genealogia-ficha-completa-btn" ' +
            'data-persona-id="' +
            escapeHtml(persona.id) +
            '">' +
            'Ver ficha completa' +
            '</button>' +
            '</p>';


        info.innerHTML = html;

        info.querySelectorAll(
            '.genealogia-persona-link'
        ).forEach(function (enlace) {
            enlace.addEventListener('click', function (event) {

                event.preventDefault();

                var personaId =
                    this.getAttribute('data-persona-id');

                mostrarFicha(personaId);
            });
        });


        var botonFicha =
            info.querySelector(
                '.genealogia-ficha-completa-btn'
            );

        if (botonFicha) {
            botonFicha.addEventListener('click', function () {

                var personaId =
                    this.getAttribute('data-persona-id');

                window.location.href =
                    'personas/ver/' + personaId;
            });
        }        
    }

    /*
     * ---------------------------------------------------------
     *  FAMILY TREE
     * ---------------------------------------------------------
     */
    new FT.FamilyTree(data, container, {
        /*
         * Conservamos el comportamiento original de la
         * biblioteca: expandir/contraer el nodo.
         *
         * Después mostramos nuestra ficha.
         */

        nodeClickFunction: function (node, ft) {
            ft.nodeClickHandler(node);

            if (node.isPerson) {
                mostrarFicha(node.data.id);
            }
        },

        /*
         * Tooltip propio.
         */
        nodeTooltipFunction: function (node) {
            if (!node || !node.isPerson) {
                return '';
            }

            var persona =
                data.persons[node.data.id];

            if (!persona) {
                return '';
            }

            var html =
                '<strong>' +
                escapeHtml(persona.name) +
                '</strong>';

            if (persona.birthyear) {
                html +=
                    '<br>Nacimiento: ' +
                    escapeHtml(persona.birthyear);
            }

            if (persona.birthplace) {
                html +=
                    '<br>Lugar: ' +
                    escapeHtml(persona.birthplace);
            }

            if (persona.deathyear) {
                html +=
                    '<br>Defunción: ' +
                    escapeHtml(persona.deathyear);
            }
            if (persona.deathplace) {
                html +=
                    '<br>Lugar: ' +
                    escapeHtml(persona.deathplace);
            }

            return html;
        }
    });

    /*
     * ---------------------------------------------------------
     *  CLICS DENTRO DE LA FICHA
     * ---------------------------------------------------------
     *
     * Estos clics están fuera del SVG del árbol, por lo que
     * no interfieren con la biblioteca gráfica.
     */
    })();
</script>