<script>
document.getElementById('arbol_id').addEventListener('change', function () {
    var arbolId = this.value;
    var select = document.getElementById('persona_referencia_id');
    select.innerHTML = '<option value="">Cargando...</option>';
    fetch('<?= PUBLIC_PATH ?>admin/usuarios/personas_arbol/' + arbolId)
        .then(function (r) { return r.json(); })
        .then(function (personas) {
            select.innerHTML = '<option value="">Seleccione una persona...</option>';
            personas.forEach(function (persona) {
                var option = document.createElement('option');
                option.value = persona.id;
                option.textContent = persona.texto;
                select.appendChild(option);
            });
        });
});
</script>
