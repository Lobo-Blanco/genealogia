                /*
                 * Estructura provisional del menú. La jerarquía es independiente
                 * de los permisos: cada elemento puede declarar una condición.
                 * Cuando definamos el menú definitivo bastará con reorganizar este
                 * árbol, sin cambiar el código que lo representa.
                 */
                $menu = array(
                    array(
                        'texto' => 'Genealogía', 'icono' => 'bi-diagram-3',
                        'hijos' => array(
                            array('texto'=>'Árboles', 'icono'=>'bi-tree', 'url'=>'arboles', 'visible'=>Auth::estaAutenticado()),
                            array(
                                'texto'=>'Eventos', 'icono'=>'bi-calendar-event',
                                'hijos'=>array(
                                    array('texto'=>'Nacimientos', 'icono'=>'bi-gift', 'url'=>'nacimientos'),
                                    array('texto'=>'Matrimonios', 'icono'=>'bi-hearts', 'url'=>'uniones'),
                                    array('texto'=>'Defunciones', 'icono'=>'bi-cross', 'url'=>'defunciones')
                                )
                            )
                        )
                    )
                );

                if (Auth::puedeAdministrarUsuarios()) {
                    $menu[] = array(
                        'texto' => 'Administración', 'icono' => 'bi-shield-lock',
                        'hijos' => array(
                            array('texto'=>'Usuarios', 'icono'=>'bi-person-gear', 'url'=>'admin/usuarios'),
                            array('texto'=>'Árboles', 'icono'=>'bi-tree', 'url'=>'arboles'),
                        )
                    );
                }

                $renderMenu = function($items, $nivel = 0) use (&$renderMenu) {
                    foreach ($items as $item) {
                        if (isset($item['visible']) && !$item['visible']) continue;
                        $hijos = isset($item['hijos']) ? $item['hijos'] : array();
                        $tieneHijos = count($hijos) > 0;
                        $url = isset($item['url']) ? $item['url'] : '#';
                        $id = 'menu_' . $nivel . '_' . substr(md5($item['texto'] . $nivel), 0, 8);
                        $claseLi = $tieneHijos
                            ? ($nivel === 0 ? 'nav-item dropdown' : 'dropdown-submenu')
                            : ($nivel === 0 ? 'nav-item' : 'nav-item');
                        $claseA = $nivel === 0 ? 'nav-link' : 'dropdown-item';
                        if ($tieneHijos) $claseA .= ' dropdown-toggle';
                        $href = $tieneHijos ? '#' : PUBLIC_PATH . $url;
                        ?>
                        <li class="<?= $claseLi ?>">
                            <a class="<?= $claseA ?>"
                               href="<?= $href ?>"
                               <?php if ($tieneHijos && $nivel === 0): ?>role="button" data-bs-toggle="dropdown" aria-expanded="false"<?php elseif ($tieneHijos): ?>aria-expanded="false"<?php endif; ?>
                               <?php if ($tieneHijos): ?>id="<?= $id ?>"<?php endif; ?>>
                                <?php if (isset($item['icono'])): ?><i class="bi <?= $item['icono'] ?>"></i><?php endif; ?><?= htmlspecialchars($item['texto'], ENT_QUOTES, 'UTF-8') ?>
                            </a>
                            <?php if ($tieneHijos): ?>
                                <ul class="dropdown-menu" aria-labelledby="<?= $id ?>">
                                    <?php $renderMenu($hijos, $nivel + 1); ?>
                                </ul>
                            <?php endif; ?>
                        </li>
                        <?php
                    }
                };
                $renderMenu($menu);
