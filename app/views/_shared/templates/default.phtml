<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function () {
    'use strict';

    document.addEventListener('DOMContentLoaded', function () {
        var currentPath = window.location.pathname;
        document.querySelectorAll('.navbar-genealogia a.nav-link').forEach(function (link) {
            var href = link.getAttribute('href');
            if (href && href !== '#' && href !== '/' && currentPath.indexOf(href) === 0) {
                link.classList.add('active');
                var parent = link.closest('.dropdown-submenu');
                while (parent) {
                    var toggle = parent.querySelector(':scope > .dropdown-toggle');
                    if (toggle) toggle.classList.add('active');
                    parent = parent.parentElement ? parent.parentElement.closest('.dropdown-submenu') : null;
                }
            }
        });

        // Bootstrap 5 no soporta submenús multinivel de forma nativa.
        // Los elementos anidados se controlan aquí; el primer nivel sigue usando Bootstrap.
        document.querySelectorAll('.dropdown-submenu > .dropdown-toggle').forEach(function (toggle) {
            toggle.addEventListener('click', function (event) {
                event.preventDefault();
                event.stopPropagation();

                var submenu = this.nextElementSibling;
                if (!submenu) return;

                var contenedor = this.parentElement.parentElement;
                contenedor.querySelectorAll(':scope > .dropdown-submenu > .dropdown-menu.show').forEach(function (menu) {
                    if (menu !== submenu) menu.classList.remove('show');
                });

                var abierto = submenu.classList.contains('show');
                submenu.classList.toggle('show', !abierto);
                this.setAttribute('aria-expanded', abierto ? 'false' : 'true');
            });
        });

        document.addEventListener('click', function (event) {
            if (!event.target.closest('.navbar-genealogia .dropdown')) {
                document.querySelectorAll('.navbar-genealogia .dropdown-menu.show').forEach(function (menu) {
                    menu.classList.remove('show');
                });
                document.querySelectorAll('.navbar-genealogia .dropdown-submenu > .dropdown-toggle[aria-expanded="true"]').forEach(function (toggle) {
                    toggle.setAttribute('aria-expanded', 'false');
                });
            }
        });

        var searchForm = document.querySelector('form[role="search"]');
        if (searchForm) {
            searchForm.addEventListener('submit', function (event) {
                var input = this.querySelector('input[name="q"]');
                if (input && input.value.trim() === '') {
                    event.preventDefault();
                    input.focus();
                }
            });
        }
    });
}());
</script>
