<script>
    /**
     * Confirmar eliminación
     */
    function confirmarEliminar(id) {
        if (confirm('¿Estás seguro de eliminar este registro? Esta acción no se puede deshacer.')) {
            // Aquí puedes hacer una petición AJAX o redirigir
            window.location.href = '<?= PUBLIC_PATH . (isset($eliminarUrl) ? $eliminarUrl : '#') ?>'.replace('{id}', id);
            return false;
        }
        return false;
    }
    
    /**
     * Filtrar por estado
     */
    function filtrar(tipo) {
        const filas = document.querySelectorAll('.table-genealogia tbody tr');
        const botones = document.querySelectorAll('.toolbar-left .btn-genealogia-outline-secondary');
        
        // Actualizar botones activos
        botones.forEach(btn => {
            btn.classList.remove('active');
            btn.style.background = 'transparent';
            btn.style.color = '#6c757d';
        });
        
        const evento = event || window.event;
        if (evento && evento.target) {
            const btn = evento.target.closest('button');
            if (btn) {
                btn.classList.add('active');
                btn.style.background = '#4a6741';
                btn.style.color = 'white';
            }
        }
        
        // Filtrar filas
        filas.forEach(fila => {
            const estadoCell = fila.querySelector('td:nth-child(4)');
            if (!estadoCell) return;
            
            const estado = estadoCell.textContent.trim().toLowerCase();
            
            if (tipo === 'todos') {
                fila.style.display = '';
            } else if (tipo === 'activos' && (estado === 'activo' || estado === 'activos')) {
                fila.style.display = '';
            } else if (tipo === 'inactivos' && (estado === 'inactivo' || estado === 'inactivos')) {
                fila.style.display = '';
            } else {
                fila.style.display = 'none';
            }
        });
    }
    
    /**
     * Resaltar fila al pasar el mouse
     */
    document.addEventListener('DOMContentLoaded', function() {
        const filas = document.querySelectorAll('.table-genealogia tbody tr');
        filas.forEach(fila => {
            fila.addEventListener('mouseenter', function() {
                this.style.backgroundColor = '#f8f5f0';
            });
            fila.addEventListener('mouseleave', function() {
                this.style.backgroundColor = '';
            });
        });
    });
</script>


